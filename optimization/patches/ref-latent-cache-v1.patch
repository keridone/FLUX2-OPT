+struct RefLatentCacheEntry {
+    uint64_t key = 0;
+    sd::Tensor<float> latent;
+    uint64_t last_used = 0;
+};
+
 struct sd_ctx_t {
     StableDiffusionGGML* sd = nullptr;
+    std::vector<RefLatentCacheEntry> ref_latent_cache;
+    uint64_t ref_latent_cache_clock     = 0;
+    uint64_t ref_latent_cache_hits      = 0;
+    uint64_t ref_latent_cache_misses    = 0;
+    uint64_t ref_latent_cache_evictions = 0;
 };
 
+static constexpr size_t REF_LATENT_CACHE_CAPACITY = 8;
+
+static uint64_t ref_latent_cache_hash_bytes(uint64_t hash, const void* data, size_t size) {
+    const uint8_t* bytes = static_cast<const uint8_t*>(data);
+    for (size_t i = 0; i < size; ++i) {
+        hash ^= bytes[i];
+        hash *= UINT64_C(1099511628211);
+    }
+    return hash;
+}
+
+template <typename T>
+static uint64_t ref_latent_cache_hash_value(uint64_t hash, const T& value) {
+    return ref_latent_cache_hash_bytes(hash, &value, sizeof(value));
+}
+
+static uint64_t ref_latent_cache_key(const sd_image_t& image,
+                                     int target_width,
+                                     int target_height,
+                                     const RefImageParams& params) {
+    uint64_t hash = UINT64_C(14695981039346656037);
+    hash          = ref_latent_cache_hash_value(hash, image.width);
+    hash          = ref_latent_cache_hash_value(hash, image.height);
+    hash          = ref_latent_cache_hash_value(hash, image.channel);
+    hash          = ref_latent_cache_hash_value(hash, target_width);
+    hash          = ref_latent_cache_hash_value(hash, target_height);
+    hash          = ref_latent_cache_hash_value(hash, params.resize_before_vae);
+    hash          = ref_latent_cache_hash_value(hash, params.resize_vae_to_target);
+    hash          = ref_latent_cache_hash_value(hash, params.vae_input_max_pixels);
+    const size_t image_bytes = static_cast<size_t>(image.width) * image.height * image.channel;
+    return ref_latent_cache_hash_bytes(hash, image.data, image_bytes);
+}
+
+static bool ref_latent_cache_get(sd_ctx_t* ctx, uint64_t key, sd::Tensor<float>* latent) {
+    ++ctx->ref_latent_cache_clock;
+    for (auto& entry : ctx->ref_latent_cache) {
+        if (entry.key == key) {
+            entry.last_used = ctx->ref_latent_cache_clock;
+            *latent         = entry.latent;
+            ++ctx->ref_latent_cache_hits;
+            LOG_INFO("ref latent cache hit (hits=%" PRIu64 ", misses=%" PRIu64 ", size=%zu/%zu)",
+                     ctx->ref_latent_cache_hits,
+                     ctx->ref_latent_cache_misses,
+                     ctx->ref_latent_cache.size(),
+                     REF_LATENT_CACHE_CAPACITY);
+            return true;
+        }
+    }
+    ++ctx->ref_latent_cache_misses;
+    return false;
+}
+
+static void ref_latent_cache_put(sd_ctx_t* ctx, uint64_t key, const sd::Tensor<float>& latent) {
+    if (REF_LATENT_CACHE_CAPACITY == 0 || latent.empty()) {
+        return;
+    }
+    if (ctx->ref_latent_cache.size() >= REF_LATENT_CACHE_CAPACITY) {
+        auto oldest = std::min_element(ctx->ref_latent_cache.begin(),
+                                       ctx->ref_latent_cache.end(),
+                                       [](const RefLatentCacheEntry& a, const RefLatentCacheEntry& b) {
+                                           return a.last_used < b.last_used;
+                                       });
+        ctx->ref_latent_cache.erase(oldest);
+        ++ctx->ref_latent_cache_evictions;
+    }
+    ctx->ref_latent_cache.push_back({key, latent, ++ctx->ref_latent_cache_clock});
+    LOG_INFO("ref latent cache store (size=%zu/%zu, evictions=%" PRIu64 ")",
+             ctx->ref_latent_cache.size(),
+             REF_LATENT_CACHE_CAPACITY,
+             ctx->ref_latent_cache_evictions);
+}
+
